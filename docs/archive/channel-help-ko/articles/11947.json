                            "text": "백그라운드 액션"
                          },
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "type": "plain"
                        }
                      ],
                      "type": "text"
                    }
                  ],
                  "type": "listItem"
                }
              ],
              "type": "bullets"
            }
          ],
          "type": "listItem"
        }
      ],
      "type": "bullets"
    },
    {
      "type": "text"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "보다 자세한 액션 관련 내용은 액션 가이드에서 확인하실 수 있습니다. (→ "
          },
          "type": "plain"
        },
        {
          "attrs": {
            "text": "액션 가이드 보러 가기"
          },
          "marks": [
            {
              "attrs": {
                "href": "https://docs.channel.io/help/ko/articles/%EC%95%A1%EC%85%98-33ffa757"
              },
              "type": "hyperlink"
            }
          ],
          "type": "plain"
        },
        {
          "attrs": {
            "text": ")"
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "type": "text"
    },
    {
      "type": "text"
    },
    {
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "attrs": {
            "text": "알아두면 좋을 워크플로우 용어"
          },
          "type": "plain"
        }
      ],
      "type": "heading"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "워크플로우를 더 효과적으로 활용할 수 있도록 알아두면 좋을 개념에 대해 추가로 안내드려요."
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "attrs": {
            "text": "모듈형 워크플로우"
          },
          "type": "plain"
        }
      ],
      "type": "heading"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "모듈형 워크플로우는 트리거 없이 생성하는 워크플로우로, 다른 워크플로우 또는 상담 중 원하는 상황에서 불러와 사용할 수 있습니다."
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "attrs": {
        "alt": "모듈형워크플로우.png",
        "height": "880px",
        "mime": "image/png",
        "src": "https://cf.channel.io/document/spaces/6/articles/149578/revisions/261903/usermedia/68091a303b677f704bfd",
        "width": "1560px"
      },
      "type": "image"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "반복적인 안내가 필요한 내용이라면, 모듈형 워크플로우로 만들어서 다른 워크플로우에 연결해 보세요."
                  },
                  "type": "plain"
                }
              ],
              "type": "text"
            }
          ],
          "type": "listItem"
        },
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "모듈형 워크플로우를 하나만 수정하면 연결된 모든 워크플로우에도 자동으로 반영되니 수정이 쉬워요."
                  },
                  "type": "plain"
                }
              ],
              "type": "text"
            }
          ],
          "type": "listItem"
        },
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "상담 중에 비슷한 문의가 들어오면 매크로 대신 모듈형 워크플로우를 직접 호출할 수도 있습니다. 메시지 입력창에 느낌표(!)를 입력하면 모듈형 워크플로우가 호출됩니다. 매크로를 사용할 때보다 더 복잡한 상담도 해결할 수 있어요. (→ "
                  },
                  "type": "plain"
                },
                {
                  "attrs": {
                    "text": "매크로 가이드 보러 가기"
                  },
                  "marks": [
                    {
                      "attrs": {
                        "href": "https://docs.channel.io/help/ko/articles/a5905ef6-%EB%A7%A4%ED%81%AC%EB%A1%9C"
                      },
                      "type": "hyperlink"
                    }
                  ],
                  "type": "plain"
                },
                {
                  "attrs": {
                    "text": ")"
                  },
                  "type": "plain"
                }
              ],
              "type": "text"
            }
          ],
          "type": "listItem"
        },
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "예시"
                  },
                  "type": "plain"
                }
              ],
              "type": "text"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "attrs": {
                            "text": "상담이 종료될 때마다 상담 만족도 조사를 받고 싶다면, 모듈형 워크플로우로 생성 후 필요한 워크플로우에서 불러와서 사용해 보세요."
                          },
                          "type": "plain"
                        }
                      ],
                      "type": "text"
                    }
                  ],
                  "type": "listItem"
                },
                {
                  "content": [
                    {
                      "content": [
                        {
                          "attrs": {
                            "text": "또는 상담 종료 후, 팀 멤버가 직접 상담 만족도 조사 워크플로우를 상담에 전송할 수 있습니다."
                          },
                          "type": "plain"
                        }
                      ],
                      "type": "text"
                    }
                  ],
                  "type": "listItem"
                }
              ],
              "type": "bullets"
            }
          ],
          "type": "listItem"
        },
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "모듈형 워크플로우 사용 방법은 워크플로우 액션 가이드를 참고해 주세요. (→ "
                  },
                  "type": "plain"
                },
                {
                  "attrs": {
                    "text": "모듈형 워크플로우 연결 가이드 보러 가기)"
                  },
                  "marks": [
                    {
                      "attrs": {
                        "href": "https://docs.channel.io/help/ko/articles/%EB%AA%A8%EB%93%88%ED%98%95-%EC%9B%8C%ED%81%AC%ED%94%8C%EB%A1%9C%EC%9A%B0-7f06f167"
                      },
                      "type": "hyperlink"
                    }
                  ],
                  "type": "plain"
                }
              ],
              "type": "text"
            }
          ],
          "type": "listItem"
        }
      ],
      "type": "bullets"
    },
    {
      "type": "text"
    },
    {
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "attrs": {
            "text": "워크플로우의 유형"
          },
          "type": "plain"
        }
      ],
      "type": "heading"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "워크플로우 유형에 따라 다른 워크플로우가 동작 중일 때 함께 동작이 가능한 것과 불가한 것으로 구분됩니다. 자세한 동작 방식은 워크플로우 동작 방식 가이드를 참고해 주세요. (→ "
          },
          "type": "plain"
        },
        {
          "attrs": {
            "text": "워크플로우 동작 방식 가이드 보러 가기"
          },
          "marks": [
            {
              "attrs": {
                "href": "https://docs.channel.io/help/ko/articles/fe5074f8-%EC%9B%8C%ED%81%AC%ED%94%8C%EB%A1%9C%EC%9A%B0-%EB%AA%A9%EB%A1%9D#%EC%9B%8C%ED%81%AC%ED%94%8C%EB%A1%9C%EC%9A%B0-%EB%8F%99%EC%9E%91-%EB%B0%A9%EC%8B%9D"
              },
              "type": "hyperlink"
            }
          ],
          "type": "plain"
        },
        {
          "attrs": {
            "text": ")"
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "type": "text"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "하나만 동작"
          },
          "marks": [
            {
              "type": "bold"
            }
          ],
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "해당 워크플로우가 동작 중일 때에는 다른 워크플로우가 트리거 되더라도 동작하지 않는, 단독으로만 동작하는 유형의 워크플로우입니다."
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "고객에게 보여지는 콘텐츠 액션 또는 응답 버튼이 포함되어 있다면 자동으로 하나만 동작 유형이 됩니다."
                  },
                  "type": "plain"
                },
                {
                  "attrs": {
                    "text": " "
                  },
                  "marks": [
                    {
                      "attrs": {
                        "semanticColor": "bgtxt-cobalt-normal"
                      },
                      "type": "color"
                    }
                  ],
                  "type": "plain"
                },
                {
                  "attrs": {
                    "text": "(→ "
                  },
                  "marks": [
                    {
                      "attrs": {
                        "semanticColor": "txt-black-darkest"
                      },
                      "type": "color"
                    },
                    {
                      "attrs": {
                        "href": "https://docs.channel.io/help/ko/articles/%EC%95%A1%EC%85%98-33ffa757#%EC%BD%98%ED%85%90%EC%B8%A0-%EC%95%A1%EC%85%98"
                      },
                      "type": "hyperlink"
                    }
                  ],
                  "type": "plain"
                },
                {
                  "attrs": {
                    "text": "콘텐츠 액션이란?"
                  },
                  "marks": [
                    {
                      "attrs": {
                        "semanticColor": "txt-black-dark"
                      },
                      "type": "color"
                    },
                    {
                      "attrs": {
                        "href": "https://docs.channel.io/help/ko/articles/%EC%95%A1%EC%85%98-33ffa757#%EC%BD%98%ED%85%90%EC%B8%A0-%EC%95%A1%EC%85%98"
                      },
                      "type": "hyperlink"
                    }
                  ],
                  "type": "plain"
                },
                {
                  "attrs": {
                    "text": ")"
                  },
                  "marks": [
                    {
                      "attrs": {
                        "semanticColor": "txt-black-darkest"
                      },
                      "type": "color"
                    },
                    {
                      "attrs": {
                        "href": "https://docs.channel.io/help/ko/articles/%EC%95%A1%EC%85%98-33ffa757#%EC%BD%98%ED%85%90%EC%B8%A0-%EC%95%A1%EC%85%98"
                      },
                      "type": "hyperlink"
                    }
                  ],
                  "type": "plain"
                }
              ],
              "type": "text"
            }
          ],
          "type": "listItem"
        },
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "하나만 동작 유형의 워크플로우를 진행 중이라면 다른 워크플로우의 트리거 조건이 충족되더라도 동작하지 않습니다."
                  },
                  "type": "plain"
                }
              ],
              "type": "text"
            }
          ],
          "type": "listItem"
        }
      ],
      "type": "bullets"
    },
    {
      "type": "text"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "항상 동작"
          },
          "marks": [
            {
              "type": "bold"
            }
          ],
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "해당 유형의 워크플로우는 트리거 조건이 일치하면 다른 워크플로우 유형과 관계없이 언제나 동작합니다."
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "type": "text"
    },
    {
