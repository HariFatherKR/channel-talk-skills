              },
              "type": "plain"
            }
          ],
          "type": "text"
        }
      ],
      "type": "callout"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "채널톡 언어를 한 가지로 고정하여 보여지도록 하는 방법도 있어요. 이 경우, 스크립트 수정이 필요합니다. 채널톡 설치 스크립트에서 language 설정을 en(영어), ko(한국어), ja(일본어)로 변경해주세요."
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "라벨 버튼, 프로필, 인사말, 봇 메시지"
          },
          "marks": [
            {
              "type": "bold"
            }
          ],
          "type": "plain"
        },
        {
          "attrs": {
            "text": " 언어가 설정해주신 하나의 언어로 고정됩니다."
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "type": "text"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "ChannelIO('boot', {\n\"pluginKey\": \"YOUR_PLUGIN_KEY\",\n\"language\": \"ko\",\n});"
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "type": "text"
    },
    {
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "attrs": {
            "text": "관리자 언어 변경"
          },
          "type": "plain"
        }
      ],
      "type": "heading"
    },
    {
      "content": [
        {
          "attrs": {
            "text": "관리자 화면의 언어도 변경이 가능하고, 이 때에는 "
          },
          "type": "plain"
        },
        {
          "attrs": {
            "text": "한국어, 영어, 일본어"
          },
          "marks": [
            {
              "type": "bold"
            }
          ],
          "type": "plain"
        },
        {
          "attrs": {
            "text": "가 지원됩니다."
          },
          "type": "plain"
        }
      ],
      "type": "text"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
