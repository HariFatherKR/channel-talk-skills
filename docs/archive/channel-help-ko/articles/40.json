              "content": [
                {
                  "attrs": {
                    "text": "고객이 방문하여 채널톡 채팅버튼을 눌렀을 때, 라운지(채팅목록) 화면의 테마를 어떻게 보여줄지 설정할 수 있습니다."
                  },
                  "type": "plain"
                }
