              "type": "text"
            }
          ],
          "type": "listItem"
        },
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "라이트, 다크, 시스템 모드로 적용 가능하며, 시스템 모드로 설정해 둔 경우 고객의 시스템(브라우저) 설정을 따라가게 됩니다."
                  },
                  "type": "plain"
                }
              ],
              "type": "text"
            }
          ],
          "type": "listItem"
        },
        {
          "content": [
            {
              "content": [
                {
                  "attrs": {
                    "text": "자체 개발 사이트라면 API를 활용하여 데스크 설정보다 더 우선적으로 적용되는 테마를 지정할 수 있습니다."
