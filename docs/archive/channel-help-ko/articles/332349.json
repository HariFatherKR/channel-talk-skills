  "linked_faqs": [
    {
      "id": "152064",
      "question": "알프(ALF)는 어떤 언어로 답변하나요?",
      "answer_plaintext": "ALF는 고객의 메시지 언어가 아닌 고객 프로필에 저장된 언어를 기준으로 답변합니다. \n\n고객 프로필의 기본 언어는 고객이 사용하는 기기 또는 브라우저의 언어 설정에 따라 자동으로 저장됩니다. 또한 고객이 직접 프로필에서 언어를 변경하실 수도 있습니다. (경로: 채널톡 버튼 > 설정(⚙️) > 언어)"
    }
  ],
  "faq_count": 1
}
